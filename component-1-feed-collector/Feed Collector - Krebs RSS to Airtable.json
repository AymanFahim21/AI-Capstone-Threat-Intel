    {
      "parameters": {
        "jsCode": "// Compares normalized Krebs RSS items against existing Airtable records.\n// Outputs only records that do NOT already exist in Airtable.\n\n// FIX #2: Replaced deprecated $items() fallback with items.map().\n// $items() is the n8n v1 API and throws in v1 execution mode,\n// causing the filter to silently fail when Airtable returns no results.\nlet normalizedItems = [];\ntry {\n  normalizedItems = $(\"Normalize Krebs RSS Items\").all().map(item => item.json);\n} catch (error) {\n  // Safe fallback using current execution context\n  normalizedItems = items.map(item => item.json);\n}\n\nconst existingKeys = new Set();\n\nfor (const item of items) {\n  const fields = item.json.fields || {};\n  const key = fields[\"Dedupe Key\"] || item.json[\"Dedupe Key\"];\n  if (key) {\n    existingKeys.add(String(key));\n  }\n}\n\nconst newRecords = normalizedItems.filter(record => {\n  const key = String(record[\"Dedupe Key\"] || \"\");\n  return key && !existingKeys.has(key);\n});\n\nreturn newRecords.map(record => ({ json: record }));"
      },
