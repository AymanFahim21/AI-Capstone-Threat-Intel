      "id": "51f862c0-deb7-49c1-a11e-29ff8d05237f",
      "name": "RSS Read - Krebs on Security"
    },
    {
      "parameters": {
        "jsCode": "// FIX #1: Replaced broken additive hash with a proper DJB2-XOR hash.\n// The old hash summed char codes, causing collisions (e.g. 'ab' == 'ba').\n// This caused new articles to be wrongly treated as duplicates.\nfunction robustHash(str) {\n  let hash = 5381;\n  for (let i = 0; i < str.length; i++) {\n    hash = ((hash << 5) + hash) ^ str.charCodeAt(i);\n    hash = hash & 0x7fffffff; // keep positive 31-bit integer\n  }\n  return hash.toString();\n}\n\nconst sourceName = 'Krebs on Security';\nconst maxItems = 50;\n\nreturn items.slice(0, maxItems).map(item => {\n  const data = item.json;\n  const url = data.link || '';\n  const title = data.title || 'Untitled RSS Item';\n  const dedupeKey = robustHash(sourceName + url);\n  const rawDescription = data.contentSnippet || data.description || data['content:encodedSnippet'] || '';\n  const rawContent = data['content:encoded'] || data.content || data.description || rawDescription || '';\n\n  return {\n    json: {\n      \"Threat ID\": dedupeKey,\n      \"Title\": title,\n      \"Source\": sourceName,\n      \"Source Type\": \"RSS\",\n      \"Category\": \"Blog\",\n      \"Published Date\": data.pubDate || data.isoDate || null,\n      \"Collected Date\": new Date().toISOString(),\n      \"URL\": url,\n      \"Raw Description\": rawDescription,\n      \"Raw Content\": rawContent,\n      \"External ID\": data.guid || url,\n      \"Dedupe Key\": dedupeKey,\n      \"Processing Status\": \"New\",\n      \"Collector Status\": \"Collected\",\n      \"Summary\": \"\",\n      \"Severity Level\": \"Unknown\",\n      \"CVE IDs\": \"\",\n      \"Affected Software\": \"\",\n      \"Tags\": \"security-blog,krebsonsecurity,rss\",\n      \"Relevance Score\": 0\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        256,
        464
      ],
      "id": "fee14c8d-53ad-4c43-b1bd-7479d1544f96",
      "name": "Normalize Krebs RSS Items"
    },
    {
      "parameters": {
        "jsCode": "const records = items.map(item => item.json);\nconst keys = records\n  .map(record => record[\"Dedupe Key\"])\n  .filter(Boolean)\n  .slice(0, 50);\n\nfunction escapeAirtableString(value) {\n  return String(value)\n    .replace(/\\\\/g, \"\\\\\\\\\")\n    .replace(/'/g, \"\\\\'\");\n}\n\nlet filterFormula = \"FALSE()\";\n\nif (keys.length === 1) {\n  filterFormula = `{Dedupe Key} = '${escapeAirtableString(keys[0])}'`;\n}\n\nif (keys.length > 1) {\n  const conditions = keys.map(key => `{Dedupe Key} = '${escapeAirtableString(key)}'`);\n  filterFormula = `OR(${conditions.join(\", \")})`;\n}\n\nreturn [\n  {\n    json: {\n      filterFormula,\n      normalizedCount: records.length,\n      dedupeKeys: keys\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
