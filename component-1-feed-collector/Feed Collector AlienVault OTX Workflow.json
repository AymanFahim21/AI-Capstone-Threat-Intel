    {
      "parameters": {
        "jsCode": "const response = items[0].json || {};\n\nlet pulses = [];\n\nif (Array.isArray(response.results)) {\n  pulses = response.results;\n} else if (Array.isArray(response.pulses)) {\n  pulses = response.pulses;\n} else if (Array.isArray(response.data)) {\n  pulses = response.data;\n} else if (Array.isArray(response)) {\n  pulses = response;\n}\n\npulses = pulses.slice(0, 50);\n\nfunction cleanText(value) {\n  return value ? String(value).replace(/<[^>]*>/g, \"\").trim() : \"\";\n}\n\nfunction arrayToText(value) {\n  if (Array.isArray(value)) {\n    return value.filter(Boolean).join(\", \");\n  }\n  return value ? String(value) : \"\";\n}\n\nreturn pulses.map(pulse => {\n  const pulseId = pulse.id || pulse.pulse_id || pulse.name || pulse.created || \"\";\n  const indicators = Array.isArray(pulse.indicators) ? pulse.indicators : [];\n\n  return {\n    json: {\n      source: \"AlienVault OTX\",\n      pulse_id: String(pulseId),\n      title: pulse.name || pulse.title || \"Untitled OTX Pulse\",\n      description: cleanText(pulse.description || pulse.content || \"\"),\n      author: pulse.author_name || pulse.author || \"Unknown\",\n      created: pulse.created || null,\n      modified: pulse.modified || null,\n      tags: arrayToText(pulse.tags),\n      malware_families: arrayToText(pulse.malware_families),\n      industries: arrayToText(pulse.targeted_industries),\n      adversary: pulse.adversary || \"\",\n      references: Array.isArray(pulse.references) ? pulse.references.join(\"\\n\") : \"\",\n      public: Boolean(pulse.public),\n      TLP: pulse.TLP || pulse.tlp || \"\",\n      indicator_count: pulse.indicator_count || indicators.length || 0,\n      export_time: new Date().toISOString()\n    }\n  };\n});"
      },
