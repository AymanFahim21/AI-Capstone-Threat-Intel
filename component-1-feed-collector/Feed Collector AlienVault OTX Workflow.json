        "jsCode": "const records = items.map(item => item.json);\n\nconst keys = records\n  .map(record => record.pulse_id)\n  .filter(Boolean)\n  .slice(0, 50);\n\nfunction escapeAirtableString(value) {\n  return String(value)\n    .replace(/\\\\/g, \"\\\\\\\\\")\n    .replace(/'/g, \"\\\\'\");\n}\n\nlet filterFormula = \"FALSE()\";\n\nif (keys.length === 1) {\n  filterFormula = `{pulse_id} = '${escapeAirtableString(keys[0])}'`;\n}\n\nif (keys.length > 1) {\n  const conditions = keys.map(key => {\n    return `{pulse_id} = '${escapeAirtableString(key)}'`;\n  });\n\n  filterFormula = `OR(${conditions.join(\",\")})`;\n}\n\nreturn [\n  {\n    json: {\n      filterFormula,\n      totalInputRecords: records.length,\n      pulseIds: keys\n    }\n  }\n];"
      },
