      "parameters": {
        "jsCode": "const normalizedRecords = $items(\"Normalize AlienVault Data1\").map(item => item.json);\n\nconst existingPulseIds = new Set();\n\nfor (const item of items) {\n  const fields = item.json?.fields || {};\n  const pulseId = fields.pulse_id;\n\n  if (pulseId) {\n    existingPulseIds.add(String(pulseId));\n  }\n}\n\nconst newRecords = normalizedRecords.filter(record => {\n  return record.pulse_id && !existingPulseIds.has(String(record.pulse_id));\n});\n\nreturn newRecords.map(record => {\n  return { json: record };\n});"
      },
