      "id": "6303d2e9-5b3d-446a-aca5-aeb24dec3be9",
      "name": "HTTP Request - NVD CVE API"
    },
    {
      "parameters": {
        "jsCode": "const response = items[0].json;\nconst vulnerabilities = (response.vulnerabilities || []).slice(0, 50);\n\nfunction getEnglishDescription(cve) {\n  const desc = cve.descriptions?.find(d => d.lang === \"en\");\n  return desc?.value || \"\";\n}\n\nfunction getCvssInfo(cve) {\n  const metrics = cve.metrics || {};\n\n  const cvss =\n    metrics.cvssMetricV31?.[0] ||\n    metrics.cvssMetricV30?.[0] ||\n    metrics.cvssMetricV2?.[0] ||\n    null;\n\n  if (!cvss) {\n    return {\n      score: 0,\n      severity: \"Unknown\"\n    };\n  }\n\n  return {\n    score: cvss.cvssData?.baseScore || 0,\n    severity: cvss.cvssData?.baseSeverity || cvss.baseSeverity || \"Unknown\"\n  };\n}\n\nfunction collectCpeMatches(node, matches = []) {\n  if (!node) return matches;\n\n  if (Array.isArray(node.cpeMatch)) {\n    matches.push(...node.cpeMatch);\n  }\n\n  if (Array.isArray(node.children)) {\n    for (const child of node.children) {\n      collectCpeMatches(child, matches);\n    }\n  }\n\n  return matches;\n}\n\nfunction getAffectedSoftware(cve) {\n  const products = new Set();\n  const nodes = cve.configurations?.nodes || [];\n\n  for (const node of nodes) {\n    const matches = collectCpeMatches(node);\n\n    for (const match of matches) {\n      const criteria = match.criteria || \"\";\n      const parts = criteria.split(\":\");\n\n      // CPE format usually looks like:\n      // cpe:2.3:a:vendor:product:version:...\n      if (parts.length >= 6) {\n        const vendor = parts[3];\n        const product = parts[4];\n\n        if (vendor && product && vendor !== \"*\" && product !== \"*\") {\n          products.add(`${vendor}:${product}`);\n        }\n      }\n    }\n  }\n\n  return Array.from(products).slice(0, 10).join(\", \");\n}\n\nreturn vulnerabilities.map(vuln => {\n  const cve = vuln.cve;\n  const cveId = cve.id;\n  const description = getEnglishDescription(cve);\n  const cvss = getCvssInfo(cve);\n  const affectedSoftware = getAffectedSoftware(cve);\n\n  const shortDescription =\n    description.length > 140\n      ? description.substring(0, 140) + \"...\"\n      : description;\n\n  return {\n    json: {\n      \"Threat ID\": `NVD-${cveId}`,\n      \"Title\": `${cveId}: ${shortDescription}`,\n      \"Source\": \"NVD CVE\",\n      \"Source Type\": \"CVE_API\",\n      \"Category\": \"CVE\",\n      \"Published Date\": cve.published || null,\n      \"Collected Date\": new Date().toISOString(),\n      \"URL\": `https://nvd.nist.gov/vuln/detail/${cveId}`,\n      \"Raw Description\": description,\n      \"Raw Content\": JSON.stringify(cve),\n      \"External ID\": cveId,\n      \"Dedupe Key\": `NVD-${cveId}`,\n      \"Processing Status\": \"New\",\n      \"Collector Status\": \"Collected\",\n      \"Summary\": \"\",\n      \"Severity Level\": cvss.severity,\n      \"CVE IDs\": cveId,\n      \"Affected Software\": affectedSoftware,\n      \"Tags\": `nvd,cve,${cvss.severity.toLowerCase()}`,\n      \"Relevance Score\": 0\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1056,
        -144
      ],
      "id": "b56631cd-dd74-42b4-8faa-d6aaeb621be7",
      "name": "Normalize NVD CVEs"
    },
    {
      "parameters": {
        "jsCode": "const records = items.map(item => item.json);\nconst keys = records\n  .map(record => record[\"Dedupe Key\"])\n  .filter(Boolean)\n  .slice(0, 50);\n\nfunction escapeAirtableString(value) {\n  return String(value).replace(/\\\\/g, \"\\\\\\\\\").replace(/'/g, \"\\\\'\");\n}\n\nlet filterFormula = \"FALSE()\";\n\nif (keys.length === 1) {\n  filterFormula = `{Dedupe Key} = '${escapeAirtableString(keys[0])}'`;\n}\n\nif (keys.length > 1) {\n  const conditions = keys.map(key => `{Dedupe Key} = '${escapeAirtableString(key)}'`);\n  filterFormula = `OR(${conditions.join(\", \")})`;\n}\n\nreturn [\n  {\n    json: {\n      filterFormula,\n      normalizedCount: records.length,\n      dedupeKeys: keys\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
