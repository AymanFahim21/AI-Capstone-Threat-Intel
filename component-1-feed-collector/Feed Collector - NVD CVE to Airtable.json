    {
      "parameters": {
        "jsCode": "// This node compares the 50 normalized CVEs against existing Airtable records.\n// It only outputs records that do NOT already exist in Airtable.\n\nlet normalizedItems = [];\n\ntry {\n  normalizedItems = $(\"Normalize NVD CVEs\").all().map(item => item.json);\n} catch (error) {\n  normalizedItems = $items(\"Normalize NVD CVEs\").map(item => item.json);\n}\n\nconst existingKeys = new Set();\n\nfor (const item of items) {\n  const fields = item.json.fields || {};\n  const key = fields[\"Dedupe Key\"] || item.json[\"Dedupe Key\"];\n\n  if (key) {\n    existingKeys.add(String(key));\n  }\n}\n\nconst newRecords = normalizedItems.filter(record => {\n  const key = String(record[\"Dedupe Key\"] || \"\");\n  return key && !existingKeys.has(key);\n});\n\nreturn newRecords.map(record => ({ json: record }));"
      },
