# Copy this file to .streamlit/secrets.toml and fill in real values.
# On Streamlit Community Cloud, paste these into Settings -> Secrets instead.
# NEVER commit the real .streamlit/secrets.toml — only this .example file.

# REQUIRED
AIRTABLE_PAT = "patXXXXXX.your_token_here"

# OPTIONAL — speeds up CVE lookups (free key at nvd.nist.gov/developers/request-an-api-key)
# NVD_API_KEY = "your_nvd_key"

# OPTIONAL — Slack alerting
# SLACK_WEBHOOK_URL = "https://hooks.slack.com/services/T.../B.../..."

# OPTIONAL — Email alerting via SMTP (Gmail requires an App Password)
# SMTP_HOST = "smtp.gmail.com"
# SMTP_PORT = 587
# SMTP_USER = "you@gmail.com"
# SMTP_PASS = "16-char-app-password"
# ALERT_TO_EMAIL = "where-alerts-go@example.com"
