        "jsCode": "return items.map(item => {\n  const recordId = item.json.recordId;\n  let parsedResponse = { score: 0 };\n  \n  try {\n    const content = item.json.choices[0].message.content;\n    parsedResponse = JSON.parse(content);\n  } catch (error) {\n    parsedResponse = { score: 0 };\n  }\n\n  return {\n    json: {\n      recordId: recordId,\n      score: parsedResponse.score\n    }\n  };\n});"
