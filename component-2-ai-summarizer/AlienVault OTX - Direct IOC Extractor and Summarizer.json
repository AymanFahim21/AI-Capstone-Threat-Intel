      "id": "3816914d-f138-429a-a1a1-036ed364a936",
      "name": "Get Full OTX Pulse Details",
      "notes": "Replace PASTE_YOUR_OTX_API_KEY_HERE with your AlienVault OTX API key. This node retrieves the structured indicators array."
    },
    {
      "parameters": {
        "jsCode": "const output = [];\n\nfunction unique(values) {\n  return [...new Set(values.map(v => String(v || \"\").trim()).filter(Boolean))];\n}\n\nfunction cleanText(value) {\n  return String(value || \"\")\n    .replace(/<[^>]*>/g, \" \")\n    .replace(/\\s+/g, \" \")\n    .trim();\n}\n\nfunction asText(value) {\n  if (!value) return \"\";\n  if (Array.isArray(value)) {\n    return value.map(v => {\n      if (typeof v === \"object\" && v !== null) {\n        return v.display_name || v.name || v.title || JSON.stringify(v);\n      }\n      return String(v);\n    }).filter(Boolean).join(\", \");\n  }\n  if (typeof value === \"object\") return JSON.stringify(value);\n  return String(value);\n}\n\nfunction extractIndicators(indicators) {\n  const ips = [];\n  const urls = [];\n  const emails = [];\n  const domains = [];\n  const hashes = [];\n  const cves = [];\n\n  for (const indicator of indicators) {\n    const value = indicator.indicator || indicator.value || indicator.ioc || \"\";\n    const type = String(indicator.type || indicator.indicator_type || \"\").toLowerCase();\n\n    if (!value) continue;\n\n    if ([\"ipv4\", \"ipv6\", \"ip\", \"ipv4-addr\", \"ipv6-addr\"].includes(type)) {\n      ips.push(value);\n    } else if ([\"url\", \"uri\"].includes(type)) {\n      urls.push(value);\n    } else if ([\"email\", \"emailaddress\", \"email-addr\"].includes(type)) {\n      emails.push(value);\n    } else if ([\"domain\", \"hostname\", \"fqdn\"].includes(type)) {\n      domains.push(value);\n    } else if (\n      [\"filehash-md5\", \"filehash-sha1\", \"filehash-sha256\", \"md5\", \"sha1\", \"sha256\"].includes(type) ||\n      type.includes(\"hash\")\n    ) {\n      hashes.push(value);\n    } else if (type === \"cve\") {\n      cves.push(value);\n    }\n  }\n\n  return {\n    ips: unique(ips),\n    urls: unique(urls),\n    emails: unique(emails),\n    domains: unique(domains),\n    hashes: unique(hashes),\n    cves: unique(cves)\n  };\n}\n\nfunction classifySeverity(text) {\n  const lower = text.toLowerCase();\n  if (\n    lower.includes(\"zero-day\") ||\n    lower.includes(\"0-day\") ||\n    lower.includes(\"remote code execution\") ||\n    lower.includes(\"rce\") ||\n    lower.includes(\"ransomware\") ||\n    lower.includes(\"credential theft\") ||\n    lower.includes(\"data exfiltration\") ||\n    lower.includes(\"worm\")\n  ) {\n    return \"High\";\n  }\n  if (\n    lower.includes(\"phishing\") ||\n    lower.includes(\"malware\") ||\n    lower.includes(\"botnet\") ||\n    lower.includes(\"exploit\") ||\n    lower.includes(\"backdoor\") ||\n    lower.includes(\"trojan\")\n  ) {\n    return \"Medium\";\n  }\n  return \"Unknown\";\n}\n\nfunction classifyAttackType(text) {\n  const lower = text.toLowerCase();\n  const types = [];\n\n  if (lower.includes(\"phishing\")) types.push(\"Phishing\");\n  if (lower.includes(\"ransomware\")) types.push(\"Ransomware\");\n  if (lower.includes(\"malware\")) types.push(\"Malware\");\n  if (lower.includes(\"botnet\")) types.push(\"Botnet\");\n  if (lower.includes(\"credential\")) types.push(\"Credential Theft\");\n  if (lower.includes(\"backdoor\")) types.push(\"Backdoor\");\n  if (lower.includes(\"trojan\")) types.push(\"Trojan\");\n  if (lower.includes(\"exploit\") || lower.includes(\"rce\") || lower.includes(\"remote code execution\")) types.push(\"Exploit\");\n  if (lower.includes(\"exfiltration\")) types.push(\"Data Exfiltration\");\n\n  return unique(types).join(\", \") || \"Unknown\";\n}\n\nfor (let i = 0; i < items.length; i++) {\n  const pulse = items[i].json || {};\n  const originalItem = $items(\"Get AlienVault OTX Records\")[i];\n  const originalFields = originalItem.json.fields || {};\n\n  const recordId = originalItem.json.id;\n  const pulseId = originalFields[\"pulse_id\"] || pulse.id || \"\";\n  const title = originalFields[\"title\"] || pulse.name || \"Untitled OTX Pulse\";\n  const description = cleanText(originalFields[\"description\"] || pulse.description || \"\");\n  const author = originalFields[\"author\"] || pulse.author_name || \"AlienVault\";\n  const created = originalFields[\"created\"] || pulse.created || \"\";\n  const modified = originalFields[\"modified\"] || pulse.modified || \"\";\n  const tags = asText(pulse.tags || originalFields[\"tags\"]);\n  const malwareFamilies = asText(pulse.malware_families || originalFields[\"malware_families\"]);\n  const industries = asText(pulse.industries || originalFields[\"industries\"]);\n  const adversary = asText(pulse.adversary || originalFields[\"adversary\"]);\n  const references = asText(pulse.references || originalFields[\"references\"]);\n  const tlp = originalFields[\"TLP\"] || pulse.tlp || \"\";\n  const indicators = Array.isArray(pulse.indicators) ? pulse.indicators : [];\n\n  const extracted = extractIndicators(indicators);\n\n  const shortDescription = description.length > 450\n    ? description.slice(0, 450) + \"...\"\n    : description;\n\n  const summary = `${title}. ${shortDescription}`.trim();\n  const combinedText = `${title} ${description} ${tags} ${malwareFamilies}`;\n\n  const recommendedActions = [\n    \"Review extracted indicators in SIEM, EDR, firewall, proxy, DNS, and email logs.\",\n    \"Block confirmed malicious IPs, domains, URLs, and hashes where appropriate.\",\n    \"Prioritize CVEs and affected software mentioned in the pulse.\",\n    \"Investigate endpoints or accounts that contacted the extracted IOCs.\",\n    \"Validate indicators before production blocking to reduce false positives.\"\n  ].join(\"\\n\");\n\n  output.push({\n    json: {\n      id: recordId,\n      source: originalFields[\"source\"] || \"AlienVault OTX\",\n      pulse_id: pulseId,\n      title,\n      description,\n      author,\n      created,\n      modified,\n      tags,\n      malware_families: malwareFamilies,\n      industries,\n      adversary,\n      references,\n      TLP: tlp,\n      indicator_count: indicators.length || originalFields[\"indicator_count\"] || 0,\n\n      \"Summary\": summary,\n      \"AI Summary\": summary,\n      \"Severity Level\": classifySeverity(combinedText),\n      \"Attack Type\": classifyAttackType(combinedText),\n      \"Affected Software\": malwareFamilies,\n      \"CVE IDs\": extracted.cves.join(\", \"),\n      \"IOC IPs\": extracted.ips.join(\", \"),\n      \"IOC Domains\": extracted.domains.join(\", \"),\n      \"IOC URLs\": extracted.urls.join(\", \"),\n      \"IOC Hashes\": extracted.hashes.join(\", \"),\n      \"IOC Emails\": extracted.emails.join(\", \"),\n      \"Recommended Actions\": recommendedActions,\n      \"Recommended Action\": recommendedActions,\n      \"Raw Indicators\": JSON.stringify(indicators, null, 2),\n      \"AI Raw Response\": \"No Flowise used. IOCs extracted directly from AlienVault OTX structured indicators. Summary generated with deterministic n8n logic.\",\n      \"AI Processed\": true,\n      \"Last Processed\": new Date().toISOString(),\n      \"Relevance Score\": 0\n    }\n  });\n}\n\nreturn output;"
      },
